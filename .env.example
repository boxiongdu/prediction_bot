# Kalshi API
# Obtain from https://kalshi.com/account/api-tokens
# Required for authenticated access; public market data may work without it.
KALSHI_API_KEY=

# Kalshi RSA authentication
# Key ID from Kalshi account page (starts with 'KK-').
KALSHI_KEY_ID=
# Path to RSA private key PEM file, or the PEM content.
KALSHI_PRIVATE_KEY_PATH=

# Logging
LOG_LEVEL=INFO

# Data directories (relative to project root unless absolute)
DATA_DIR=./data
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
FEATURES_DIR=./data/features
MODELS_DIR=./data/models
SNAPSHOTS_DIR=./data/snapshots
RESULTS_DIR=./data/results

# Kalshi API base URL
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# HTTP client settings
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_RATE_LIMIT_CALLS_PER_SECOND=5
